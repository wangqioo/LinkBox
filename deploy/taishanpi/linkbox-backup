#!/usr/bin/env bash
set -euo pipefail

DATA_DIR="${LINKBOX_DATA_DIR:-/var/lib/linkbox}"
BACKUP_DIR="${LINKBOX_BACKUP_DIR:-/var/backups/linkbox}"
KEEP_DAYS="${LINKBOX_BACKUP_KEEP_DAYS:-14}"
STAMP="$(date +%Y%m%d-%H%M%S)"
DEST="$BACKUP_DIR/linkbox-$STAMP.tar.gz"

mkdir -p "$BACKUP_DIR"

if [[ ! -d "$DATA_DIR" ]]; then
  echo "missing data dir: $DATA_DIR" >&2
  exit 1
fi

tar -C "$DATA_DIR" -czf "$DEST" .
find "$BACKUP_DIR" -type f -name 'linkbox-*.tar.gz' -mtime +"$KEEP_DAYS" -delete

echo "$DEST"
